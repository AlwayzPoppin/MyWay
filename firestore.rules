rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /circleMemberships/{circleId}/members/{userId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /customers/{userId}/checkout_sessions/{sessionId} {
      allow read, create: if signedIn() && request.auth.uid == userId;
    }

    // RTDB remains the source of truth for saved places. This mirror is private.
    match /places/{placeId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /community_pins/{pinId} {
      allow read, create, update, delete: if signedIn();
    }
    match /public_map_reports/{reportId} {
      allow read, create, update, delete: if signedIn();
    }
    match /incidents/{incidentId} {
      allow read, create, update, delete: if signedIn();
    }

    // Anonymous, append-only community regular-fuel reports. Contributors do
    // not publish profile identifiers, and clients cannot rewrite history.
    match /community_fuel_price_reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'stationId', 'stationName', 'latitude', 'longitude', 'price', 'grade', 'reportedAt'])
        && request.resource.data.keys().hasAll(['id', 'stationId', 'stationName', 'latitude', 'longitude', 'price', 'grade', 'reportedAt'])
        && request.resource.data.stationId is string
        && request.resource.data.stationName is string
        && request.resource.data.stationName.size() <= 120
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.price is number
        && request.resource.data.price >= 1 && request.resource.data.price <= 15
        && request.resource.data.grade == 'regular'
        && request.resource.data.reportedAt is number;
      allow update, delete: if false;
    }

    // Building photos are community contributions. Only the author may alter one.
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reviewStatus == 'pending';
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.reviewStatus == resource.data.reviewStatus;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /sharedTrips/{driverId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, update: if signedIn() && request.auth.uid == driverId
        && request.resource.data.driverId == driverId
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.status in ['active', 'arrived', 'ended'];
      allow delete: if signedIn() && request.auth.uid == driverId;
    }
  }
}
